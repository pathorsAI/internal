{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Copy this file to `wrangler.jsonc` and fill in your own values.
  // `wrangler.jsonc` is gitignored so deployment-specific identifiers
  // (account id, custom domain, bucket / worker names) stay out of version control.
  "name": "my-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare account id. Either set it here, or omit it and export
  // CLOUDFLARE_ACCOUNT_ID in your environment (wrangler reads it natively).
  // "account_id": "<your-cloudflare-account-id>",
  "workers_dev": true,
  // Optional custom domain. Remove this block to deploy on *.workers.dev only.
  "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "my-app-storage" }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "My App"
  }
}
