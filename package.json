{
  "name": "internal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "overrides": {
    "kysely": "0.28.17"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "db:pull": "dotenv -e .env.local -- drizzle-kit pull",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:apply": "bun scripts/migrate.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "bun run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "bun run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/sso": "^1.7.20",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.16",
