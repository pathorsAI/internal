# Postgres connection string (pooled). Set the real value in .env.local.
# Any Postgres works; on Cloudflare Workers use a serverless/HTTP driver (e.g. Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL of the app (no trailing slash). Dev: http://localhost:3000
# Also used as the OAuth issuer for the MCP server, so it MUST match the public
# URL your MCP client connects to (e.g. https://app.example.com). See docs/mcp.md.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URIs (add your prod URLs too when deploying):
#   http://localhost:3000/api/auth/callback/google                  ← sign-in
#   http://localhost:3000/api/auth/oauth2/callback/google-calendar  ← Google Calendar integration
# The Calendar integration reuses these same credentials but is a separate consent
# flow, so signing in never asks for calendar access. Enable the Google Calendar API
# on the project and add the .../auth/calendar scope to the OAuth consent screen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Field-level encryption for integration credentials (Simpany, Wise) and employee
# bank account numbers. 32 random bytes, base64: openssl rand -base64 32
# Prod: wrangler secret put FIELD_ENCRYPTION_KEY. Losing it makes stored
# credentials unreadable (reconnect integrations, re-enter account numbers).
FIELD_ENCRYPTION_KEY=""

# Platform OIDC signing key: signs short-lived per-organization JWTs (sub = organization id)
# that GCP Workload Identity Federation exchanges for a token — no per-org service account
# key needed. RSA private key, PKCS#8 DER as ONE line of base64 without PEM headers (a full
# PEM also works). Prod: wrangler secret put OIDC_SIGNING_KEY. The public key is served at
# /.well-known/jwks.json. Only needed for GCP billing in workload_identity mode.
OIDC_SIGNING_KEY=""
# Optional overrides (defaults shown).
# OIDC_SIGNING_KID="internal-2026-10b"
# OIDC_ISSUER="https://internal.pathors.com"

# Transactional email via Resend (https://resend.com): public sign-up confirmation
# links (/signup) and password reset links (/forgot-password).
# Required in production — prod: wrangler secret put RESEND_API_KEY.
# Leave empty in local dev: each email (including its link) is printed to the
# server console instead of being sent.
RESEND_API_KEY=""
# Optional sender. Default: "Pathors Internal <noreply@pathors.com>". The domain
# must be verified in Resend.
# RESEND_FROM="Your App <noreply@example.com>"
